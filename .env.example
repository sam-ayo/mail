# Public URL of the app. OAuth redirect URIs use this value.
APP_URL=http://localhost:5180

# Random secret for session cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# 32-byte key (base64) that encrypts account tokens and passwords at rest.
# Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=

# Neon Postgres connection string. Use a dev branch for local work.
DATABASE_URL=

# Google (Gmail) OAuth client. Redirect URI: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft (Outlook / Microsoft 365) OAuth app. Redirect URI: ${APP_URL}/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Shared secret for the scheduled jobs (Vercel cron and the Cloudflare Worker in worker/).
# Generate one with: openssl rand -base64 32
CRON_SECRET=

# VAPID keys for push notifications. Generate them with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mail@samayo.me

# API key of TypeSafe (https://console.typesafe.ai/keys). Its model Jev does the
# AI sorting of the inbox into Important and Promotions. Empty turns AI sorting off.
TYPESAFE_API_KEY=

# Password of the reviewer sign-in at /review. Directory reviewers of Claude and
# ChatGPT get a new workspace with demo accounts. Leave empty to turn it off.
REVIEW_PASSWORD=

# Token that ChatGPT gives to verify the domain. The app serves it at
# /.well-known/openai-apps-challenge.
OPENAI_APPS_CHALLENGE=
